# ─────────────────────────────────────────────────────────────
# 复制本文件为 .env 后修改。.env 已在 .gitignore 中排除，切勿提交。
# 生成 SECRET_KEY：
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# ─────────────────────────────────────────────────────────────

# 【必填】Django 密钥。生产环境严禁使用示例值。
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string

# 调试开关：生产环境必须为 False
DJANGO_DEBUG=True

# 允许访问的主机名/IP。用 IP 访问时把服务器 IP 填进来，多个用逗号分隔。
# 例：DJANGO_ALLOWED_HOSTS=47.98.xx.xx,127.0.0.1,localhost
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 前端来源（跨域白名单）。开发时是 Vite 端口；生产环境填 http://服务器IP
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ─────────────────────────────────────────────────────────────
# 数据库
#   本地开发：留空即可，默认使用 SQLite（server/db.sqlite3）
#   生产环境：改成下面注释里的 MySQL 配置
# ─────────────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# 生产环境 MySQL 示例（取消注释并填写）：
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=workportal
# DB_USER=workportal
# DB_PASSWORD=在这里填强密码
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ─────────────────────────────────────────────────────────────
# Token 有效期
# ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=7

# ─────────────────────────────────────────────────────────────
# 站点名称（显示在浏览器标题与登录页）
# ─────────────────────────────────────────────────────────────
SITE_NAME=个人工作门户

# ─────────────────────────────────────────────────────────────
# 仅生产环境需要：备案完成、上了域名和 HTTPS 后改为 True
# ─────────────────────────────────────────────────────────────
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SESSION_COOKIE_SECURE=False
# DJANGO_CSRF_COOKIE_SECURE=False
# DJANGO_BEHIND_TLS_PROXY=False
